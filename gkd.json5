// ============================================================
// 自用 GKD 订阅规则（单文件版）
// GKD 直接订阅本文件的 raw 链接即可，无需构建、无需 Node 环境
// 怎么加规则、改规则、更新，见同目录《维护教程.md》
// 说明：以下规则移植自公开第三方订阅（AIsouler / Lin-arm），
//       仅作起点，未在本机机型/App版本上实测，不触发或误点时发截图修正
// ============================================================
{
  // 订阅标识：全库唯一的大随机数字，创建后不要再改，改了 GKD 会当成另一个订阅
  id: 72491583,
  name: '自用GKD规则',
  version: 2, // 每修改一次规则就 +1，GKD 才会检测到更新并提示
  author: 'myself',

  // 本文件的 raw 订阅链接（两者填同一个）
  updateUrl: 'https://raw.githubusercontent.com/youshu2008/gkd-subscription/main/gkd.json5',
  checkUpdateUrl: 'https://raw.githubusercontent.com/youshu2008/gkd-subscription/main/gkd.json5',
  supportUri: 'https://gkd.li/',

  // 规则类别（可选，先留空；需要分类时按《维护教程》添加）
  categories: [],

  // 全局规则组（跨所有 App 通用的规则，先留空；一般用不到）
  globalGroups: [],

  // 各 App 的规则都写在这里，一个 App 一段；新增时复制下方整块模板改即可
  apps: [

    // ---------------- 抖音 ----------------
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          priorityTime: 10000,
          rules: [
            {
              fastQuery: true,
              excludeActivityIds: '.search.activity.SearchResultActivity',
              matches: '[text*="跳过"][text.length<10][width<500 && height<300][visibleToUser=true]',
            },
          ],
        },
        {
          key: 1,
          name: '更新提示-关闭更新弹窗',
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              activityIds: '.main.MainActivity',
              matches: ['[text*="立即升级"]', '[text="以后再说"]'],
            },
          ],
        },
        {
          key: 2,
          name: '其他-个性化推荐弹窗',
          fastQuery: true,
          activityIds: '.main.MainActivity',
          rules: [
            {
              matches: ['[text*="个性化推荐"][visibleToUser=true]', '[text="稍后再说"][visibleToUser=true]'],
            },
          ],
        },
        {
          key: 3,
          name: '青少年模式',
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              excludeActivityIds: '.setting.ui.SettingCommonProtocolActivity',
              matches: [
                '[text*="青少年" || text*="未成年"][text*="模式"]',
                '[text="关闭" || text="不再提醒" || text="我知道了"]',
              ],
            },
          ],
        },
      ],
    },

    // ---------------- 小米应用商店 ----------------
    {
      id: 'com.xiaomi.market',
      name: '小米应用商店',
      groups: [
        {
          key: 0,
          name: '全屏广告-弹窗广告',
          fastQuery: true,
          matchRoot: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              action: 'clickCenter',
              activityIds: ['.ui.FloatWebActivity', '.ui.HomeFloatWebActivity'],
              matches: '@Button[text="关闭" || desc="关闭"][clickable=true][visibleToUser=true] <<n [vid="webview"]',
            },
            {
              activityIds: '.business_ui.main.MarketTabActivity',
              matches: '[vid="iv_ad"] + [vid="iv_close"]',
            },
          ],
        },
        {
          key: 1,
          name: '局部广告-卡片广告',
          fastQuery: true,
          rules: [
            {
              activityIds: '.ui.UpdateListActivity',
              matches: '[vid="iv_close_tip" || vid="orchard_banner_close"]',
            },
          ],
        },
        {
          key: 2,
          name: '权限提示-通知权限',
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              name: '升级软件后的开启推送弹窗',
              activityIds: '.ui.UpdateListActivity',
              matches: '[vid="dialog_cancel" || text="不再提醒"][visibleToUser=true]',
            },
          ],
        },
      ],
    },

    // ---------------- 华为应用市场 ----------------
    {
      id: 'com.huawei.appmarket',
      name: '华为应用市场',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          priorityTime: 10000,
          rules: [{ matches: '[vid="clock_layout"]' }],
        },
        {
          key: 1,
          name: '更新提示',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              activityIds: '.MarketActivity',
              matches: '@[text="以后再说"] + [text="立即更新"]',
            },
          ],
        },
        {
          key: 2,
          name: '全屏广告-热门应用推荐弹窗',
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              matches: '[text="直接进入" || text="进入主页"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 3,
          name: '局部广告-卡片广告',
          fastQuery: true,
          rules: [
            {
              activityIds: '.MarketActivity',
              matches: '[vid="close_icon"]',
            },
          ],
        },
        {
          key: 4,
          name: '权限提示-通知权限',
          desc: '点击[以后再说]',
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              activityIds:
                'com.huawei.appgallery.jointmessage.jointmessage.impl.activity.NotificationSwitchDialogActivity',
              matches: '[text="以后再说"][visibleToUser=true]',
            },
          ],
        },
      ],
    },

    // ---------------- 华为运动健康 ----------------
    {
      id: 'com.huawei.health',
      name: '华为运动健康',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          priorityTime: 10000,
          rules: [
            {
              action: 'clickCenter',
              matches: '[vid="hiad_skip_text"]',
            },
          ],
        },
        {
          key: 1,
          name: '局部广告',
          fastQuery: true,
          activityIds: '.MainActivity',
          rules: [
            {
              matches: '[vid="marketing_close_icon" || vid="close_button_layout"]',
            },
          ],
        },
        {
          key: 2,
          name: '其他-请求开启实时推送步数弹窗',
          desc: '点击取消',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              activityIds: '.MainActivity',
              matches: [
                '[text*="实时推送步数" || text*="通知栏实时显示步数"][visibleToUser=true]',
                '[text*="取消"][visibleToUser=true]',
              ],
            },
          ],
        },
        {
          key: 3,
          name: '更新提示',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              action: 'back',
              activityIds: 'com.huawei.hwversionmgr.activity.AppUpdateDialogActivity',
              matches: '[text="发现新版本"]',
            },
          ],
        },
      ],
    },

    // ---------------- 云闪付 ----------------
    {
      id: 'com.unionpay',
      name: '云闪付',
      groups: [
        {
          key: 0,
          name: '权限提示-定位权限',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            // ★本条为自学首条：2026-11-22 抓云闪付首页快照实测
            // 黑条「开启定位权限」右侧白色 ×，节点 vid = view_locate_close，自身 clickable=true
            // 快照审查里用 [vid="view_locate_close"] 查询，全页只命中这 1 个节点
            {
              activityIds: '.activity.UPActivityMain',
              matches: '[vid="view_locate_close"][clickable=true]',
            },
            // 下面两条为公开源移植，本机未实测，留作备选
            {
              activityIds: '.activity.UPActivityMain',
              matches: '@[clickable=true] > [vid="locate_iv_close"]',
            },
            {
              activityIds: ['.activity.UPActivityMain', '.base.UPDialog'],
              matches: ['[text*="访问您的位置信息"]', '[text="不允许"]'],
            },
          ],
        },
        {
          key: 1,
          name: '权限提示-通知权限',
          desc: '点击关闭',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              activityIds: '.base.UPDialog',
              matches: '[text="开启消息通知"] < * + [vid="view_alert_cancel"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 2,
          name: '全屏广告-领取优惠弹窗',
          desc: '点击关闭',
          rules: [
            {
              fastQuery: true,
              activityIds: '.cordova.UPActivityCordovaWeb',
              matches: '@View[clickable=true][text="关闭按钮"] <<n [vid="view_content_container"]',
            },
          ],
        },
      ],
    },

    // ↓↓↓↓↓ 新增 App 规则时，复制下面这一整块，改掉注释里的内容 ↓↓↓↓↓
    // {
    //   id: 'com.example.app',        // App 包名（手机 设置→应用管理→应用信息 里可查）
    //   name: '示例App',              // 给这条规则起的显示名
    //   groups: [
    //     {
    //       key: 0,                   // 同一个 App 内，规则组编号从 0 开始依次递增，不能重复
    //       name: '开屏广告',          // 规则组名称，会显示在 GKD 列表里
    //       rules: {
    //         // 选择器：在 GKD 的「快照审查」里抓快照测出来，复制粘贴到这里
    //         matches: 'TextView[id="com.example.app:id/btn_skip"]',
    //       },
    //       snapshotUrls: [],         // 参考截图链接，只给编辑器对照用，自用可留空
    //     },
    //   ],
    // },
    // ↑↑↑↑↑ 复制模板到这里结束 ↑↑↑↑↑

  ],
}
